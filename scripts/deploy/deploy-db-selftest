#!/usr/bin/env bash
set -Eeuo pipefail

readonly SELFTEST_ROOT="$(mktemp -d)"
trap 'rm -rf "${SELFTEST_ROOT}"' EXIT
touch "${SELFTEST_ROOT}/foundation.sql" "${SELFTEST_ROOT}/indexes.sql"
export FUKUROU_FOUNDATION_SQL="${SELFTEST_ROOT}/foundation.sql"
export FUKUROU_FOUNDATION_INDEX_SQL="${SELFTEST_ROOT}/indexes.sql"
export FUKUROU_DEPLOY_DB_HELPER_SOURCE="$(dirname "$0")/fukurou-deploy-db"

# shellcheck source=fukurou-deploy-db
source "$(dirname "$0")/fukurou-deploy-db"
grep -Fq 'command timeout --foreground --signal=TERM --kill-after=5' < <(declare -f psql_exec_impl)

manifest_digest() {
  local relative_path installed_path content_hash
  while IFS=$'\t' read -r relative_path installed_path; do
    content_hash="$(sha256sum "${installed_path}" | awk '{print $1}')"
    printf '%s\0%s\0' "${relative_path}" "${content_hash}"
  done | sha256sum | awk '{print $1}'
}

manifest_contract_accepts() {
  local installed_actual="$1" installed_recorded="$2" candidate_expected="$3"
  [[ "${installed_actual}" == "${installed_recorded}" && "${installed_actual}" == "${candidate_expected}" ]]
}

initial_manifest="$(calculate_db_helper_manifest)"
[[ "${initial_manifest}" =~ ^[0-9a-f]{64}$ ]]
[[ "$(calculate_db_helper_manifest)" == "${initial_manifest}" ]]
printf 'changed\n' >"${SELFTEST_ROOT}/foundation.sql"
[[ "$(calculate_db_helper_manifest)" != "${initial_manifest}" ]]
printf '' >"${SELFTEST_ROOT}/foundation.sql"

legacy_helper="${SELFTEST_ROOT}/legacy-fukurou-deploy-db"
legacy_foundation="${SELFTEST_ROOT}/legacy-foundation.sql"
legacy_indexes="${SELFTEST_ROOT}/legacy-indexes.sql"
legacy_mcp_role="${SELFTEST_ROOT}/legacy-mcp-role.sql"
printf 'legacy helper\n' >"${legacy_helper}"
printf 'legacy foundation\n' >"${legacy_foundation}"
printf 'legacy indexes\n' >"${legacy_indexes}"
printf 'legacy role\n' >"${legacy_mcp_role}"
legacy_manifest="$({
  printf '%s\t%s\n' \
    scripts/deploy/fukurou-deploy-db "${legacy_helper}" \
    scripts/deploy/sql/deploy-foundation-v1-indexes.sql "${legacy_indexes}" \
    scripts/deploy/sql/deploy-foundation-v1.sql "${legacy_foundation}" \
    scripts/deploy/sql/mcp-role.sql "${legacy_mcp_role}" | LC_ALL=C sort
} | manifest_digest)"

# 旧4-file installed set から新3-file candidateへは、marker未更新の混在状態を拒否し、
# 新artifact setのexact配置後に現helper APIでmarkerを再生成した状態だけを受理する。
! manifest_contract_accepts "${legacy_manifest}" "${legacy_manifest}" "${initial_manifest}"
manifest_contract_accepts "${initial_manifest}" "${initial_manifest}" "${initial_manifest}"
# rollback方向も同様に、新3-file installed setのまま旧candidateを拒否し、旧4-file setと
# 旧markerのexact復元だけを受理する。内容の一部だけ差し替えたmixed setもfail-closedになる。
! manifest_contract_accepts "${initial_manifest}" "${initial_manifest}" "${legacy_manifest}"
manifest_contract_accepts "${legacy_manifest}" "${legacy_manifest}" "${legacy_manifest}"
printf 'mixed foundation\n' >"${legacy_foundation}"
mixed_manifest="$({
  printf '%s\t%s\n' \
    scripts/deploy/fukurou-deploy-db "${legacy_helper}" \
    scripts/deploy/sql/deploy-foundation-v1-indexes.sql "${legacy_indexes}" \
    scripts/deploy/sql/deploy-foundation-v1.sql "${legacy_foundation}" \
    scripts/deploy/sql/mcp-role.sql "${legacy_mcp_role}" | LC_ALL=C sort
} | manifest_digest)"
! manifest_contract_accepts "${mixed_manifest}" "${legacy_manifest}" "${legacy_manifest}"

MODE=PRE_FOUNDATION
LAST_PSQL_ARGS="${SELFTEST_ROOT}/psql-args"
LAST_PSQL_TIMEOUT="${SELFTEST_ROOT}/psql-timeout"
LAST_SNAPSHOT_QUERY="${SELFTEST_ROOT}/snapshot-query"
HAS_RUNTIME_CONFIG=false
docker() {
  if [[ "$1" == "inspect" && "${*: -1}" == "${APPLICATION_CONTAINER}" ]]; then return 1; fi
  return 1
}
psql_exec() {
  printf '%s\n' "$*" > "${LAST_PSQL_ARGS}"
  local query="$*"
  if [[ "${query}" != *"-c"* ]]; then
    query+=$'\n'"$(cat)"
  fi
  if [[ "${query}" == *"foundationCatalogFingerprint"* ]]; then
    printf '%s\n' "${query}" > "${LAST_SNAPSHOT_QUERY}"
  fi
  if [[ "${query}" == *"infrastructure_gap_events"* && "${query}" == *"to_regclass"* ]]; then
    [[ "${MODE}" == FOUNDATION_V1 ]] && printf 't\n' || printf 'f\n'
  elif [[ "${query}" == *"llm_launch_maintenance"* && "${query}" == *"to_regclass"* ]]; then
    [[ "${MODE}" == FOUNDATION_V1 ]] && printf 't\n' || printf 'f\n'
  elif [[ "${query}" == *"llm_pid_registrations"* && "${query}" == *"to_regclass"* ]]; then
    [[ "${MODE}" == FOUNDATION_V1 ]] && printf 't\n' || printf 'f\n'
  elif [[ "${query}" == *"runtime_config_versions"* && "${query}" == *"to_regclass"* ]]; then
    [[ "${HAS_RUNTIME_CONFIG}" == true ]] && printf 't\n' || printf 'f\n'
  elif [[ "${query}" == *"jsonb_build_object('generation'"* ]]; then
    printf '{"generation":4,"enabled":true,"deploymentId":"fixture"}\n'
  elif [[ "${query}" == *"jsonb_build_object('active'"* ]]; then
    printf '{"active":0,"total":2}\n'
  else
    printf '{"captureDbTimestamp":"2026-07-13T00:00:00.000000Z","runtimeConfigVersion":"","runtimeConfigHash":"","preFilterActive":"","foundationCatalogFingerprint":"fixture"}\n'
  fi
}
psql_exec_with_timeout() {
  printf '%s\n' "$1" > "${LAST_PSQL_TIMEOUT}"
  shift
  psql_exec "$@"
}

install_foundation >/dev/null
! grep -Fq -- '--set=mcp_role=' "${LAST_PSQL_ARGS}"
grep -Fxq -- '60' "${LAST_PSQL_TIMEOUT}"
install_indexes >/dev/null
grep -Fxq -- '300' "${LAST_PSQL_TIMEOUT}"

pre_snapshot="$(snapshot)"
[[ "$(jq -r '.installKind' <<<"${pre_snapshot}")" == PRE_FOUNDATION ]]
[[ "$(jq -r '.maintenance.enabled' <<<"${pre_snapshot}")" == false ]]
grep -Fq "relkind::text" "${LAST_SNAPSHOT_QUERY}"

MODE=FOUNDATION_V1
foundation_snapshot="$(snapshot)"
[[ "$(jq -r '.installKind' <<<"${foundation_snapshot}")" == FOUNDATION_V1 ]]
[[ "$(jq -r '.maintenance.generation' <<<"${foundation_snapshot}")" == 4 ]]
[[ "$(jq -r '.pidRegistrations.total' <<<"${foundation_snapshot}")" == 2 ]]

HAS_RUNTIME_CONFIG=true
runtime_snapshot="$(snapshot)"
[[ "$(jq -r '.installKind' <<<"${runtime_snapshot}")" == FOUNDATION_V1 ]]
grep -Fq "c.relkind::text" "${LAST_SNAPSHOT_QUERY}"
grep -Fxq -- '-Atq' "${LAST_PSQL_ARGS}"

echo "DEPLOY_DB_SELFTEST_OK manifest=three-file-deterministic-change-sensitive transitions=4-to-3,3-to-4,mixed-fail-closed snapshots=pre-foundation,foundation-v1,runtime-config"
